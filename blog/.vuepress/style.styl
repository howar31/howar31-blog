@import "prism-monokai.styl"

$whiteColor = #FFFFFF;
$lightColor = #FFFFFF;
$darkColor = #272822;
$blackColor = #000000;

/**
 * Site
 */
body {
    background-color: $lightColor;
}

/**
 * Navbar
 */
.navbar {
    background-color: $darkColor;
    color: $lightColor;
    border-bottom: 0;
    box-shadow: 0 0 1px 0px $blackColor;
}
.navbar .links {
    background-color: $darkColor;
}
.navbar .site-name {
    color: $lightColor;
}
.nav-links a.router-link-active,
.nav-links a:hover {
    color: $whiteColor;
}
.dropdown-wrapper .nav-dropdown .dropdown-item {
    color: $darkColor;
}
@media (min-width: 719px) {
    .nav-links a.router-link-active,
    .nav-links a:hover {
        color: $whiteColor;
    }
}
@media (max-width: 719px) {
    .nav-links a.router-link-active,
    .nav-links a:hover {
        color: $accentColor;
    }
}


/**
 * Sidebar
 */
.sidebar {
    background-color: $lightColor;
    border-right: 0;
}
@media (max-width: 719px) {
    .theme-container.sidebar-open .sidebar {
        background-color: $darkColor;
        color: $lightColor;
    }
    a.sidebar-link,
    .dropdown-wrapper .nav-dropdown .dropdown-item {
        color: $lightColor;
    }
    .sidebar .nav-links {
        border-bottom: 1px solid $blackColor;
    }
}

/**
 * Page
 */
.content:not(.custom),
.page-edit,
.page-nav {
    max-width: 900px;
}